PORT=8082
CPI_BASE_URL=https://your-tenant.cfapps.us10-001.hana.ondemand.com
CPI_AUTH_MODE=oauth

# Basic Auth (used when CPI_AUTH_MODE=basic)
CPI_USERNAME=your-email@company.com
CPI_PASSWORD=your-password

# OAuth 2.0 (used when CPI_AUTH_MODE=oauth)
CPI_OAUTH_TOKEN_URL=https://your-tenant.authentication.us10.hana.ondemand.com/oauth/token
CPI_OAUTH_CLIENT_ID=your-client-id
CPI_OAUTH_CLIENT_SECRET=your-client-secret

BACKEND_API_KEY=your-secret-key
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
ALLOWED_ORIGINS=http://localhost:5175
